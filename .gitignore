# Secrets / auth — never commit
cookies.txt
.ytdl_cookies_*

# Downloaded media & outputs
downloads/
*.mp4
*.mkv
*.webm
*.m4a
*.srt
*.vtt

# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# Editor / local tooling
.claude/

# API: the saved key, and the Colab server log
.api_key
.api_key_new
.api_port
.api_outdir
api.log

# Gradio writes this when api.py --share runs from the repo folder
.gradio/

# The per-folder run locks (downloader.py hold_folder): advisory, and they die
# with the process, so there is never anything to commit or clean up.
.ytmeer-*.lock
